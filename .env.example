# Cloudflare R2 credentials
# Create from Cloudflare dashboard -> R2 -> Manage R2 API Tokens
# Permission: "Object Read & Write" scoped to one bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=

# Cloudflare R2 API token for R2 Data Catalog (Iceberg).
# Create from Cloudflare dashboard -> R2 -> Manage R2 API Tokens.
# Permission: "Admin Read & Write" (bundles R2 Storage + R2 Data
# Catalog write). Bearer token for PyIceberg RestCatalog + the
# catalog-enable management call.
R2_TOKEN_VALUE=

# MotherDuck personal-plan token
# Get from MotherDuck UI -> Settings -> Tokens
MOTHERDUCK_TOKEN=
